<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0</TargetFrameworks>
    <OutputType>library</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>NU1903</NoWarn>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>ByteAether.Ulid.AspNetCore - ULID route constraints, JSON, and OpenAPI support for ASP.NET Core</Title>
    <Description>Official ASP.NET Core integration for ByteAether.Ulid. Adds ULID route constraints, model binding support, JSON serialization for `Ulid` values, and optional OpenAPI/Swagger schema metadata for Minimal APIs, MVC, and web apps.</Description>

    <PackageId>ByteAether.Ulid.AspNetCore</PackageId>
    <PackageIcon>logo_ulid_aspnetcore.png</PackageIcon>
    <PackageTags>ulid;aspnetcore;asp-net-core;route-constraint;model-binding;minimal-api;openapi;swagger;json;web;csharp</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>

    <RootNamespace>ByteAether.Ulid.AspNetCore</RootNamespace>
    <AssemblyName>ByteAether.Ulid.AspNetCore</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ulid\Impl.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.2.3" PrivateAssets="all" Condition="'$(TargetFramework)' != 'net9.0' and '$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.10.2" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.0.0" PrivateAssets="all" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.0.0" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\assets\logo_ulid_aspnetcore.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="PACKAGE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
